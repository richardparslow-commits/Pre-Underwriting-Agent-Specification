    "check:portal": "tsx scripts/check-portal-auth.ts",
    "check:server-bank": "tsx scripts/check-server-bank.ts",
    "check:server-policy": "tsx scripts/check-server-policy.ts",
    "generate:server-bank": "tsx scripts/generate-server-bank.ts",
    "generate:server-policy": "tsx scripts/generate-server-policy.ts",
    "generate:source-index": "tsx scripts/generate-source-index.ts",
    "generate:question-refs": "tsx scripts/generate-question-refs.ts",
    "test:consent": "tsx --test src/features/consent/marketingConsent.test.ts",
    "test:engine": "tsx --test src/features/interview/engine.test.ts",
