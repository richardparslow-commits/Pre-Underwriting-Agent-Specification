    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "lovable-tagger": "^1.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
