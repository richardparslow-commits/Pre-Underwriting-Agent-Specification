# ---------------------------------------------------------------------------
# Front-end configuration (safe to expose: these are public values)
# ---------------------------------------------------------------------------
# Leave both blank to run the built-in preview mode: no backend, no email,
# cases held in the current browser tab only.
VITE_SUPABASE_URL=
# Lovable Cloud uses the publishable key; older projects call it the anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# "preview" (default) or "live". Live requires the Supabase values above.
VITE_APP_MODE=preview

# Optional. Defaults to ${VITE_SUPABASE_URL}/functions/v1/submit-case
VITE_SUBMIT_CASE_URL=

# ---------------------------------------------------------------------------
# Marketing channels (public build-time values)
# ---------------------------------------------------------------------------
# The TCPA disclosure names this entity as the authorized seller. While it is
# empty, no marketing consent is requested anywhere in the interview.
# VITE_LEGAL_ENTITY=
#
# Marketing consent is offered only for channels switched on here. Every flag
# defaults to false; do not enable a channel the business does not operate.
# VITE_MARKETING_CALLS=false
# VITE_MARKETING_TEXTS=false
# Only set these when the calls actually use the technology described.
# VITE_MARKETING_AUTODIALER=false
# VITE_MARKETING_AI_VOICE=false

# ---------------------------------------------------------------------------
# Server-side secrets — set in Supabase / Lovable Cloud, NEVER in this file
# ---------------------------------------------------------------------------
# APP_ORIGIN=https://your-site.example
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# CASE_NOTIFY_FROM=Life Policy Pilot <notifications@lifepolicypilot.blog>
# CASE_NOTIFY_TO=richardparslow@lifepolicypilot.blog
# EMAIL_WEBHOOK_SECRET=
# CRON_SECRET=
# RATE_LIMIT_SALT=...                                # required in production; missing salt fails closed
# QUESTIONNAIRE_APPROVED=false                        # stays false until every bank row is signed off
# ENVIRONMENT=production
